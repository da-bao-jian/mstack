{
	"name": "mstack",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"packageManager": "bun@1.3.8",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"smoke:browser": "bun run --filter @mstack/cli smoke:browser",
		"check": "tsc --build",
		"lint": "biome check . --error-on-warnings",
		"test": "bun test packages apps",
		"build": "bun run --workspaces --if-present build",
		"deadcode": "knip",
		"gen:skills": "bun scripts/gen-skill-docs.ts",
		"live:skills": "bun scripts/live-skills.ts",
		"live:smoke": "bun run --filter @mstack/funding live:smoke",
		"live:mcp": "bun run --filter @mstack/cli live:mcp"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"knip": "6.41.0",
		"typescript": "7.0.2"
	}
}

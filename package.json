{
	"name": "mobstack",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"packageManager": "bun@1.3.8",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"check": "tsc --build",
		"lint": "biome check . --error-on-warnings",
		"test": "bun test packages apps",
		"build": "bun run --workspaces --if-present build",
		"deadcode": "knip",
		"live:smoke": "bun run --filter @mobstack/funding live:smoke"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"knip": "6.41.0",
		"typescript": "7.0.2"
	}
}

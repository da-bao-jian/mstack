{
	"name": "mstack",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"bun": ">=1.3.0"
	},
	"packageManager": "bun@1.3.8",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"smoke:walletconnect": "bun run --filter @mstack/cli smoke:walletconnect",
		"smoke:walletconnect:mock": "bun run --filter @mstack/cli smoke:walletconnect:mock",
		"smoke:browser": "bun run --filter @mstack/cli smoke:browser",
		"check": "tsc --build",
		"lint": "biome check . --error-on-warnings",
		"test": "bun test --timeout 30000 packages apps",
		"build": "bun run --workspaces --if-present build",
		"deadcode": "knip",
		"gen:skills": "bun scripts/gen-skill-docs.ts",
		"live:skills": "bun scripts/live-skills.ts",
		"live:smoke": "bun run --filter @mstack/funding live:smoke",
		"live:mcp": "bun run --filter @mstack/cli live:mcp",
		"smoke:open": "bun run --filter @mstack/cli smoke:open",
		"smoke:bind": "bun run --filter @mstack/cli smoke:bind",
		"smoke:onboard": "bun run --filter @mstack/cli smoke:onboard",
		"smoke:ceremony": "bun run --filter @mstack/cli smoke:ceremony",
		"smoke:home": "bun run --cwd apps/cli smoke:home",
		"smoke:submit": "bun run --cwd apps/cli smoke:submit",
		"smoke:journey-e": "bun run --cwd apps/cli smoke:journey-e",
		"smoke:paste-prompt": "bun scripts/smoke-paste-prompt.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.2",
		"knip": "6.41.0",
		"typescript": "7.0.2"
	}
}

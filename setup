#!/bin/sh
set -eu
if ! command -v bun >/dev/null 2>&1; then
  printf '%s\n' 'setup builds mob with Bun 1.3 or newer, and Bun is not on PATH.' \
    'Install Bun from https://bun.sh (curl -fsSL https://bun.sh/install | bash), open a new terminal, and run ./setup again.' >&2
  exit 1
fi
MOB_SETUP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec bun "$MOB_SETUP_ROOT/scripts/setup.ts" "$@"

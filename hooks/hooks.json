{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "exec \"${CLAUDE_PLUGIN_ROOT}/bin/mob\" hook sign-guard",
						"timeout": 10
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "exec bash \"${CLAUDE_PLUGIN_ROOT}/scripts/install-message.sh\"",
						"timeout": 5
					}
				]
			}
		]
	}
}

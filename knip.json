{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"packages/mobius-client": { "project": ["src/**/*.ts", "test/**/*.ts"] },
		"packages/proposals": { "project": ["src/**/*.ts", "test/**/*.ts"] },
		"packages/signers": { "project": ["src/**/*.ts", "test/**/*.ts"] },
		".": {
			"entry": ["packages/*.test.ts", "scripts/setup.ts"],
			"project": ["packages/*.ts", "scripts/**/*.ts"]
		},
		"packages/funding": {
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/opportunities": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"apps/cli": {
			"entry": ["src/main.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		}
	}
}

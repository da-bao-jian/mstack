{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["packages/*.test.ts"],
			"project": ["packages/*.ts"]
		},
		"packages/funding": {
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/opportunities": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"apps/cli": {
			"entry": ["src/main.ts"],
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		}
	}
}

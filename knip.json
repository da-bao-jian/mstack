{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		"packages/liquidation": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"packages/mobius-client": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"packages/proposals": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"packages/signers": {
			"entry": [
				"test/walletconnect-compiled.ts",
				"src/walletconnect-worker.ts"
			],
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		".": {
			"entry": [
				"packages/*.test.ts",
				"scripts/setup.ts",
				"scripts/sign-guard.ts"
			],
			"project": ["packages/*.ts", "scripts/**/*.ts"]
		},
		"packages/funding": {
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/opportunities": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		},
		"apps/cli": {
			"project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
		},
		"packages/brand": {
			"project": ["src/**/*.ts", "test/**/*.ts"]
		}
	},
	"ignoreIssues": {
		"packages/mobius-client/src/onboarding/aster.ts": ["exports"]
	}
}

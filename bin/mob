#!/bin/sh
set -eu
MOB_BIN_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
MSTACK_ROOT=$(CDPATH='' cd -- "$MOB_BIN_DIR/.." && pwd -P)
export MSTACK_ROOT
verbose() {
  if [ "${MSTACK_VERBOSE:-}" = 1 ]; then
    printf 'mob: using %s %s\n' "$1" "$2" >&2
  fi
}
install_error() {
  printf '%s\n' 'mob could not find or install a binary. Install options:' \
    '  1. Install Bun >= 1.3, then run ./setup --host claude or ./setup --host codex in the checkout.' \
    "  2. After the first public release: curl --proto '=https' --tlsv1.2 -fsSL https://raw.githubusercontent.com/da-bao-jian/mstack/main/install.sh | sh" \
    '  3. Download mob and SHA256SUMS from https://github.com/da-bao-jian/mstack/releases, verify it, and set MSTACK_MOB_BIN to its path.' >&2
  exit 1
}
if [ -n "${MSTACK_MOB_BIN:-}" ]; then
  [ -x "$MSTACK_MOB_BIN" ] || { printf 'MSTACK_MOB_BIN is not executable: %s\n' "$MSTACK_MOB_BIN" >&2; install_error; }
  verbose MSTACK_MOB_BIN "$MSTACK_MOB_BIN"
  exec "$MSTACK_MOB_BIN" "$@"
fi
if [ -x "$MSTACK_ROOT/apps/cli/dist/mob" ]; then
  verbose 'checkout binary' "$MSTACK_ROOT/apps/cli/dist/mob"
  exec "$MSTACK_ROOT/apps/cli/dist/mob" "$@"
fi
MOB_VERSION=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MSTACK_ROOT/.claude-plugin/plugin.json") || install_error
case "$MOB_VERSION" in *[!0-9.]*) printf '%s\n' 'mob: invalid plugin version' >&2; install_error ;; esac
if ! printf '%s\n' "$MOB_VERSION" | LC_ALL=C grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
  printf '%s\n' 'mob: invalid plugin version' >&2
  install_error
fi
MOB_CACHE="$HOME/.mob/bin/mob-$MOB_VERSION"
if [ -x "$MOB_CACHE" ]; then
  verbose 'cached binary' "$MOB_CACHE"
  exec "$MOB_CACHE" "$@"
fi
if command -v bun >/dev/null 2>&1 && [ -d "$MSTACK_ROOT/apps/cli/src" ]; then
  printf '%s\n' 'mob: building checkout binary with Bun' >&2
  (cd "$MSTACK_ROOT" && bun install --frozen-lockfile >&2 && bun run build >&2) || install_error
  [ -x "$MSTACK_ROOT/apps/cli/dist/mob" ] || install_error
  exec "$MSTACK_ROOT/apps/cli/dist/mob" "$@"
fi
if sh "$MSTACK_ROOT/install.sh" --version "$MOB_VERSION" --cache-only >&2; then
  exec "$MOB_CACHE" "$@"
fi
install_error

{
	"name": "@mstack/cli",
	"version": "0.4.12",
	"private": true,
	"type": "module",
	"license": "MIT",
	"dependencies": {
		"@mstack/keys": "workspace:*",
		"@mstack/mobius-api": "workspace:*",
		"@mstack/mobius-client": "workspace:*",
		"@mstack/proposals": "workspace:*",
		"@mstack/signers": "workspace:*",
		"viem": "2.57.4",
		"@mstack/funding": "workspace:*",
		"@mstack/opportunities": "workspace:*",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@mstack/liquidation": "workspace:*",
		"@mstack/brand": "workspace:*"
	},
	"scripts": {
		"smoke:walletconnect": "bun scripts/smoke-walletconnect.ts",
		"smoke:walletconnect:mock": "bun scripts/smoke-walletconnect-mock.ts",
		"smoke:browser": "bun scripts/smoke-browser.ts",
		"smoke:proposals": "bun scripts/smoke-proposals.ts",
		"check": "tsc --build",
		"lint": "biome check . --error-on-warnings",
		"test": "bun test",
		"build": "bun build --compile src/main.ts ../../packages/signers/src/walletconnect-worker.ts --entry-naming '[name].[ext]' --outfile dist/mob",
		"live:smoke": "bun run scripts/live-smoke.ts",
		"live:mcp": "bun run scripts/live-mcp.ts",
		"smoke:open": "bun scripts/smoke-open.ts",
		"smoke:bind": "bun scripts/smoke-bind.ts",
		"smoke:onboard": "bun scripts/smoke-onboard.ts",
		"smoke:ceremony": "bun scripts/smoke-ceremony.ts",
		"smoke:home": "bun scripts/smoke-home.ts",
		"smoke:submit": "bun scripts/smoke-submit.ts",
		"smoke:journey-e": "bun scripts/smoke-journey-e.ts"
	}
}
